NODE_ENV=production
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=glutenia
# MONGODB_URI can be used instead of MONGO_URI if your host uses that name.
MONGO_DB_NAME=glutenia
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=
# Required for POST /api/scan/label (AI ingredient-label scanning via Groq).
# Get a key at https://console.groq.com/keys — without it, that one endpoint
# returns a clear "not configured" error instead of a raw SDK failure.
GROQ_API_KEY=
